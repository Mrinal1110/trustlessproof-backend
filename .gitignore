cat > .gitignore <<'EOF'
# ----------------------------
# Global ignores
# ----------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# ----------------------------
# Node / frontend
# ----------------------------
node_modules/
dist/
dist-ssr/
.vercel/

# ----------------------------
# Python / backend / agent
# ----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.env

# ----------------------------
# Workspace directories
# ----------------------------
# Workspace directories (keep tracked, ignore only artifacts)
agent-core/node_modules/
backend/__pycache__/
backend/*.sqlite
backend/*.db
marketing/dist/

# ----------------------------
# Local artifacts
# ----------------------------
*.sqlite
*.db
*.log
EOF
